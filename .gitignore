# Environment and local secrets
.env
.env.*
!.env.example

# Composer dependencies
/vendor/

# CodeIgniter writable runtime data
/writable/cache/*
!/writable/cache/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html

# Test and editor artifacts
.phpunit.result.cache
.idea/
.vscode/

# Private keys and local database files
*.pem
*.key
*.sqlite
*.sqlite3
*.db
